    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "json-server": "^0.17.4",
    "postcss": "^8.4.49",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.10"
