  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server.js",
    "test": "vitest",
    "server:dev": "tsx watch backend/src/server.ts",
    "server:build": "tsc -p tsconfig.server.json",
    "server:typecheck": "tsc -p tsconfig.server.json --noEmit",
    "server:start": "node dist-server/server.js",
    "server:test": "vitest run backend/tests/app.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:check": "tsx backend/src/scripts/check-db.ts",
    "db:status": "prisma migrate status"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
