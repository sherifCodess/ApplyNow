# Backend runtime
NODE_ENV=development
PORT=5000

# Frontend origin allowed to call the API
CORS_ORIGIN=http://localhost:5173

# Rate limiting (initial development defaults; production limits require review)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
DATABASE_URL="postgresql://applynow_app:YOUR_APP_PASSWORD@localhost:5432/applynow_dev?schema=public"
MIGRATION_DATABASE_URL="postgresql://applynow_owner:YOUR_OWNER_PASSWORD@localhost:5432/applynow_dev?schema=public"

# Transactional email (configure when SendByte account is available)
SENDBYTE_API_KEY=
EMAIL_FROM=

# Frontend URL used in email verification links
APP_BASE_URL=http://localhost:5173